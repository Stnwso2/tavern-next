{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern Next",
  "version": "0.1.2",
  "identifier": "com.tavernnext.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tavern Next",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RTQ1REZBRDY1N0YxMjEKUldRaDhWZlcrbDNrUkcremFyRHZaSy9FZGhkcXhaWXRhWDlrVkVsbnBzZXU0Nmlqbm5nKzQxYlUK",
      "endpoints": [
        "https://github.com/Stnwso2/tavern-next/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
